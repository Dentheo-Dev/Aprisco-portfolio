---
const year = new Date().getFullYear();
const links = [
  { href: '#modulos', label: 'Módulos' },
  { href: '#arquitetura', label: 'Tecnologia' },
  { href: '#precos', label: 'Preços' },
  { href: 'mailto:dentheo20@gmail.com', label: 'Contato' },
];
---

<footer>
  <div class="footer-logo">
    <img src="/logo_aprisco.png" width="28" height="28" alt="" />
    Apri<span>sco</span>
  </div>
  <p>© {year} Aprisco · Sistema de Gestão Eclesiástica · Brasil · por Theo Software</p>
  <ul class="footer-links">
    {links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
</footer>

<style>
  footer {
    background: #1a0e06;
    color: rgba(255, 255, 255, 0.5);
    padding: 3rem 5vw;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 900;
    color: white;
  }
  .footer-logo span { color: var(--dourado); }
  .footer-logo img {
    border-radius: 50%;
    object-fit: cover;
  }
  footer p { font-size: 0.82rem; }
  .footer-links { display: flex; gap: 1.5rem; list-style: none; flex-wrap: wrap; }
  .footer-links a {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-links a:hover { color: var(--verde-claro); }

  @media (max-width: 700px) {
    footer { flex-direction: column; text-align: center; }
  }
</style>
